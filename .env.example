# Copy this file to .env and replace placeholders with real values.
# Never commit .env or expose a secret key to the frontend.

# Backend
PORT=5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
